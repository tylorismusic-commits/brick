@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix idpy:  <http://harrisonconsoles.com/lv2/inlinedisplay#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .

@prefix brick: <https://github.com/tylorismusic-commits/brick> .

<https://github.com/tylorismusic-commits/brick>
	a lv2:Plugin ,
		lv2:LimiterPlugin ;
	lv2:binary <brick.so> ;
	lv2:majorVersion 0 ;
	lv2:minorVersion 2 ;
	lv2:microVersion 0 ;
	lv2:project <https://github.com/tylorismusic-commits/brick> ;
	lv2:optionalFeature lv2:hardRTCapable , idpy:queue_draw , idpy:in_gui ;
	lv2:extensionData idpy:interface ;
	doap:license <https://spdx.org/licenses/GPL-3.0-or-later.html> ;
	doap:name "Brick" ;
	doap:description "Transparent lookahead peak limiter with optional true-peak and RMS modes." ;
	doap:shortdesc "Modern transparent mastering limiter." ;
	foaf:homepage <https://github.com/tylorismusic-commits/brick> ;
	ui:ui <https://github.com/tylorismusic-commits/brick#ui> ;
	lv2:port
		[
			a lv2:AudioPort ,
			lv2:InputPort ;
			lv2:index 0 ;
			lv2:symbol "in_l" ;
			lv2:name "Input Left" ;
			pg:group <brick#input> ;
			lv2:designation pg:left ;
			] ,
		[
			a lv2:AudioPort ,
			lv2:InputPort ;
			lv2:index 1 ;
			lv2:symbol "in_r" ;
			lv2:name "Input Right" ;
			pg:group <brick#input> ;
			lv2:designation pg:right ;
			] ,
		[
			a lv2:AudioPort ,
			lv2:OutputPort ;
			lv2:index 2 ;
			lv2:symbol "out_l" ;
			lv2:name "Output Left" ;
			pg:group <brick#output> ;
			lv2:designation pg:left ;
			] ,
		[
			a lv2:AudioPort ,
			lv2:OutputPort ;
			lv2:index 3 ;
			lv2:symbol "out_r" ;
			lv2:name "Output Right" ;
			pg:group <brick#output> ;
			lv2:designation pg:right ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 4 ;
			lv2:symbol "input_gain" ;
			lv2:name "Input" ;
			lv2:group <brick#limiter> ;
			lv2:default 0 ;
			lv2:minimum -20 ;
			lv2:maximum 20 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 5 ;
			lv2:symbol "ceiling" ;
			lv2:name "Ceiling" ;
			lv2:group <brick#limiter> ;
			lv2:default -1 ;
			lv2:minimum -20 ;
			lv2:maximum 0 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 6 ;
			lv2:symbol "release" ;
			lv2:name "Release" ;
			lv2:group <brick#limiter> ;
			lv2:default 100 ;
			lv2:minimum 10 ;
			lv2:maximum 1000 ;
			units:unit units:ms ;
			lv2:portProperty lv2:logarithmic ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 7 ;
			lv2:symbol "lookahead" ;
			lv2:name "Lookahead" ;
			lv2:group <brick#limiter> ;
			lv2:default 3 ;
			lv2:minimum 0 ;
			lv2:maximum 5 ;
			units:unit units:ms ;
			lv2:documentation "Effective lookahead inside the fixed 5 ms latency window." ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 8 ;
			lv2:symbol "link" ;
			lv2:name "Link" ;
			lv2:group <brick#limiter> ;
			lv2:default 100 ;
			lv2:minimum 0 ;
			lv2:maximum 100 ;
			units:unit units:pc ;
			lv2:scalePoint [ rdfs:label "0" ; rdf:value 0 ] ;
			lv2:scalePoint [ rdfs:label "50" ; rdf:value 50 ] ;
			lv2:scalePoint [ rdfs:label "100" ; rdf:value 100 ] ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 9 ;
			lv2:symbol "true_peak" ;
			lv2:name "True Peak" ;
			lv2:group <brick#mode> ;
			lv2:default 1 ;
			lv2:minimum 0 ;
			lv2:maximum 1 ;
			lv2:portProperty lv2:integer ,
			lv2:toggled ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 10 ;
			lv2:symbol "rms_mode" ;
			lv2:name "RMS Mode" ;
			lv2:group <brick#mode> ;
			lv2:default 0 ;
			lv2:minimum 0 ;
			lv2:maximum 1 ;
			lv2:portProperty lv2:integer ,
			lv2:toggled ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 11 ;
			lv2:symbol "enable" ;
			lv2:name "Enabled" ;
			lv2:group <brick#global> ;
			lv2:default 1 ;
			lv2:minimum 0 ;
			lv2:maximum 1 ;
			lv2:portProperty lv2:integer ,
			lv2:toggled ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:OutputPort ;
			lv2:index 12 ;
			lv2:symbol "gr_meter" ;
			lv2:name "Gain Reduction" ;
			lv2:group <brick#global> ;
			lv2:default 0 ;
			lv2:minimum -60 ;
			lv2:maximum 0 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:OutputPort ;
			lv2:index 13 ;
			lv2:symbol "out_meter" ;
			lv2:name "Output Peak" ;
			lv2:group <brick#global> ;
			lv2:default -60 ;
			lv2:minimum -60 ;
			lv2:maximum 6 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:OutputPort ;
			lv2:index 14 ;
			lv2:symbol "in_meter" ;
			lv2:name "Input Peak" ;
			lv2:group <brick#global> ;
			lv2:default -60 ;
			lv2:minimum -60 ;
			lv2:maximum 6 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:OutputPort ;
			lv2:index 15 ;
			lv2:symbol "true_peak_meter" ;
			lv2:name "True Peak" ;
			lv2:group <brick#global> ;
			lv2:default -60 ;
			lv2:minimum -60 ;
			lv2:maximum 6 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:OutputPort ;
			lv2:index 16 ;
			lv2:symbol "rms_meter" ;
			lv2:name "RMS" ;
			lv2:group <brick#global> ;
			lv2:default -60 ;
			lv2:minimum -60 ;
			lv2:maximum 6 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:OutputPort ;
			lv2:index 17 ;
			lv2:symbol "latency" ;
			lv2:name "Latency" ;
			lv2:group <brick#global> ;
			lv2:default 0 ;
			lv2:minimum 0 ;
			lv2:maximum 100000 ;
			lv2:designation lv2:latency ;
			units:unit units:frame ;
			lv2:documentation "Fixed lookahead delay in samples." ;
			] .

<https://github.com/tylorismusic-commits/brick#input>
	a pg:Group ;
	lv2:name "Input" ;
	lv2:symbol "input" ;
	.

<https://github.com/tylorismusic-commits/brick#output>
	a pg:Group ;
	lv2:name "Output" ;
	lv2:symbol "output" ;
	.

<https://github.com/tylorismusic-commits/brick#limiter>
	a pg:Group ;
	lv2:name "Limiter" ;
	lv2:symbol "limiter" ;
	.

<https://github.com/tylorismusic-commits/brick#mode>
	a pg:Group ;
	lv2:name "Mode" ;
	lv2:symbol "mode" ;
	.

<https://github.com/tylorismusic-commits/brick#global>
	a pg:Group ;
	lv2:name "Global" ;
	lv2:symbol "global" ;
	.

<https://github.com/tylorismusic-commits/brick#ui>
	a ui:X11UI ;
	ui:binary <brickUI.so> ;
	lv2:requiredFeature ui:idleInterface , ui:parent ;
	lv2:optionalFeature ui:resize , opts:options ;
	lv2:extensionData ui:idleInterface , ui:resize ;
	opts:supportedOption ui:scaleFactor ;
	ui:portNotification [
			ui:plugin <https://github.com/tylorismusic-commits/brick> ;
			ui:portIndex 12 ;
	] , [
			ui:plugin <https://github.com/tylorismusic-commits/brick> ;
			ui:portIndex 13 ;
	] , [
			ui:plugin <https://github.com/tylorismusic-commits/brick> ;
			ui:portIndex 14 ;
	] , [
			ui:plugin <https://github.com/tylorismusic-commits/brick> ;
			ui:portIndex 15 ;
	] , [
			ui:plugin <https://github.com/tylorismusic-commits/brick> ;
			ui:portIndex 16 ;
	] ;
	.
